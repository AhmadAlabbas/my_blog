Options -Indexes
DirectoryIndex app.php
ErrorDocument 404 /404.html
RewriteEngine On
# PHP entrypoint controls all article URLs, including files from older static exports.
RewriteRule ^ar/?$ app.php?page=index&lang=ar [L,QSA]
RewriteRule ^ar/([a-z0-9-]+)\.html$ app.php?page=$1&lang=ar [L,QSA]
RewriteRule ^$ app.php?page=index [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^([a-z0-9-]+)\.html$ app.php?page=$1 [L,QSA]
<FilesMatch "^(blog-config.*|seed\.json|arabic\.json)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
