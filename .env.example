NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
# SQLite is for isolated local development. Production uses a persistent MySQL database.
DB_DRIVER=sqlite
DATA_DIR=./.local-data
# Production: set DB_DRIVER=mysql and use Hostinger's exact database settings.
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_SSL=false
# SESSION_SECRET=provide-a-random-secret-of-at-least-32-characters
# SETUP_TOKEN=provide-a-different-random-secret-for-first-time-admin-setup
# UPLOAD_DIR=/absolute/persistent/path/to/uploads
